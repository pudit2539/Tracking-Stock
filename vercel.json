{
  "version": 2,
  "rewrites": [
    { "source": "/webhook", "destination": "/api/index.js" },
    { "source": "/api/webhook", "destination": "/api/index.js" },
    { "source": "/api/line/webhook", "destination": "/api/index.js" },
    { "source": "/api/cron", "destination": "/api/cron.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 1 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}

