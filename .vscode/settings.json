{
  "git.autofetch": false,
  "git.autoStash": false,
  "git.status.submodules": false,
  "git.detectSubmodules": false,
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/data/**": true,
    "**/*.db*": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/data": true
  }
}
